# Academy (Next.js) — never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cforge_app:replace-with-app-db-password@127.0.0.1:5432/cforge
MIGRATOR_DATABASE_URL=postgres://cforge_migrator:replace-with-migrator-db-password@127.0.0.1:5432/cforge
SESSION_SECRET=replace-with-64-char-random
JUDGE_URL=http://127.0.0.1:7080
JUDGE_SECRET=replace-with-shared-judge-secret
# Faculty invitation API. Not a college roster identity.
FACULTY_TOKEN=replace-with-faculty-token
# Separate faculty login. Must not reuse DATABASE_URL.
FACULTY_DATABASE_URL=postgres://cforge_faculty:replace-with-faculty-db-password@127.0.0.1:5432/cforge
# Production judge stays off until isolation is accepted.
JUDGE_ALLOW_PRODUCTION=0
# docker = existing local GCC container (default on this Mac).
# firecracker = job API on a private Linux/KVM URL (127.0.0.1:7081).
# mock is for automated tests only and is not a VM.
JUDGE_BACKEND=docker
# JUDGE_URL=http://127.0.0.1:7081
# Optional development-only invite (ignored when NODE_ENV=production).
ALLOW_DEV_INVITE=0
DEV_INVITE_TOKEN=
# Trust X-Forwarded-For / X-Real-IP only behind a verified proxy.
CFORGE_TRUST_PROXY=0
# Public browser origin when /api is reverse-proxied (required in production).
# CFORGE_PUBLIC_ORIGIN=https://your-app.vercel.app
# Optional override for the verified roster CSV.
# CFORGE_VERIFIED_ROSTER_PATH=
# Optional rate-limit overrides (defaults in docs/SECURITY.md).
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Judge service
JUDGE_PORT=7080
JUDGE_TIME_LIMIT_MS=2000
JUDGE_MEMORY_LIMIT_MB=64
JUDGE_OUTPUT_LIMIT_BYTES=65536
JUDGE_PIDS_LIMIT=32
