# Pinned Firecracker/Jailer release. Installer verifies the official GitHub SHA-256 file.
FIRECRACKER_VERSION=v1.12.0
FIRECRACKER_RELEASE_BASE=https://github.com/firecracker-microvm/firecracker/releases/download/v1.12.0

# Guest kernel used by the official Firecracker CI images (downloaded on Linux provision).
# SHA-256 is recorded at download time into /var/lib/cforge/firecracker/SHA256SUMS.
CFORGE_FC_KERNEL_URL_X86_64=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.12/x86_64/vmlinux-6.1.102
CFORGE_FC_KERNEL_URL_AARCH64=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.12/aarch64/vmlinux-6.1.102
CFORGE_GUEST_GCC=13
