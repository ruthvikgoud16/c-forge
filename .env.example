# Server-only. Never prefix these with VITE_.
# Browser calls stay same-origin (/api). SSR and the production /api proxy use this.
CFORGE_API_ORIGIN=https://your-cforge-api.onrender.com

# Public browser origin after Vercel project `cforge` is created:
# https://cforge.vercel.app
# https://cforge.vercel.com is a custom domain and needs ownership + DNS verification.
# Do not set it until Vercel shows it as verified.

# Do not set VITE_CFORGE_DEMO in production.
